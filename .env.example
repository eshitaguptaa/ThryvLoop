# =============================================================================
# ThryvLoop environment variables
# Copy to .env.local for local development. Set the same keys in Vercel (or your
# host) for production. Never commit real secrets.
# =============================================================================

# --- App URL (required in production for OAuth redirects & invites) ---
# Use your canonical production URL (pick www OR apex — use the same everywhere).
# Production: https://www.thryvloop.com
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (required) ---
# Use pk_live_ / sk_live_ keys in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/?auth=signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/?auth=signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home
# Webhook: POST https://YOUR_DOMAIN/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- Supabase (required) ---
# Run all files in supabase/migrations/ on your project before launch.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Google Workspace OAuth (required for Calendar / Gmail sync) ---
# Used only when a signed-in user connects Calendar/Gmail in-app.
# Clerk Google SSO must request profile/email only — do not add calendar or
# gmail.readonly scopes in Clerk Dashboard → SSO connections → Google.
# See docs/WORKSPACE_INTEGRATIONS.md for Google Cloud setup.
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# 32+ char random string — encrypts stored refresh tokens
WORKSPACE_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Optional overrides
# GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/workspace/callback/google
# WORKSPACE_OAUTH_STATE_SECRET=
# NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NAME=Thryvloop
# NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- ThryvBot / Gemini (required for AI chat & analytics insights) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REQUESTS_PER_MINUTE=10
# GEMINI_REQUESTS_PER_DAY=50
# GEMINI_API_CALLS_PER_MINUTE=25

# --- In-app notifications (optional — for sending users bell notifications) ---
# POST /api/notifications with Authorization: Bearer <secret>
# APP_NOTIFICATIONS_ADMIN_SECRET=change-me-to-a-long-random-string

# --- Feature flags ---
# B2B workspaces (Teams) — on unless set to false (inlined at build time)
NEXT_PUBLIC_ENABLE_B2B_WORKSPACES=true

# --- Workspace invite email (Resend) ---
# Branded invites land better in Gmail Primary than Clerk's default mail.
# Verify the from-domain in Resend, then set:
# RESEND_API_KEY=re_...
# INVITE_EMAIL_FROM=ThryvLoop <invites@thryvloop.com>
# TEAMS_NOTIFY_TO=you@yourdomain.com
# TEAMS_NOTIFY_FROM=ThryvLoop <notify@thryvloop.com>
